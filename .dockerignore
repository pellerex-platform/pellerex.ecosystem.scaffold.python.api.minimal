# Keep the build context small (P7 / PY-R8). The Django scaffold shipped none.
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.git/
.gitignore
.github/
*.md
.editorconfig
.dockerignore
Dockerfile
infrastructure/
# The Dockerfile's unit-tests stage runs tests/, and tests/test_chart.py reads the chart.
!infrastructure/Helm/
start/
secrets.example
.DS_Store
*.log
